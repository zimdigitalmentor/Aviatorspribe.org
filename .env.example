# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=5173
PUBLIC_BASE_URL=http://localhost:5173
# Docker Compose creates the database with this password (docker compose up --build)
POSTGRES_PASSWORD=
# Used when running the app outside Docker (npm start); Compose overrides it inside the container
DATABASE_URL=postgres://aviator:<POSTGRES_PASSWORD>@localhost:5433/aviator_tracker?sslmode=disable
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
# test | live
PAYNOW_MODE=test
# Merchant account login email (used as authemail in test mode only)
PAYNOW_TEST_AUTHEMAIL=
# true once Visa/Mastercard is verified on the merchant account
PAYNOW_CARDS_ENABLED=false

# Optional
# Comma-separated Gmail addresses allowed to call the admin reset-device endpoint
ADMIN_EMAILS=
# Shown when a phone move is refused, e.g. WhatsApp +263 77 000 0000
SUPPORT_CONTACT=
# "Free" when the owner absorbs Paynow fees, otherwise e.g. "2.5%"
FEE_LABEL=Free
RUN_JOBS=true

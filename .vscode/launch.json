{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Start dev server",
      "program": "${workspaceFolder}/server.js"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Open in Chrome",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/public"
    }
  ],
  "compounds": [
    { "name": "Server + Chrome", "configurations": ["Start dev server", "Open in Chrome"] }
  ]
}
